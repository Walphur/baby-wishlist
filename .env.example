# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role key: NUNCA la expongas en el cliente, solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Alias de Mercado Pago para donar por transferencia (0%, no es link de pago)
NEXT_PUBLIC_MP_DONATION_ALIAS=dsl.store
# QR de cobro por API (comisión de QR presencial). No hace falta para el alias.
# MP_ACCESS_TOKEN=
